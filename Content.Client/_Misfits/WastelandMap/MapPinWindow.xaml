<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc mappin-window-title}"
               MinWidth="420"
               MinHeight="130"
               SetSize="420 130">
    <BoxContainer Orientation="Vertical" Margin="8">
        <Label Text="{Loc mappin-window-prompt}" Margin="0 0 0 6" />
        <LineEdit Name="NameInput"
                  PlaceHolder="{Loc mappin-window-placeholder}"
                  HorizontalExpand="True"
                  Margin="0 0 0 8" />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="CancelButton" Text="{Loc mappin-window-cancel}" Margin="0 0 6 0" MinWidth="80" />
            <Button Name="SubmitButton" Text="{Loc mappin-window-submit}" MinWidth="80" StyleClasses="Caution" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
